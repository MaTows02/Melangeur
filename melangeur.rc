#include <winver.h>

1 ICON "assets/melangeur.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "MaTows"
            VALUE "FileDescription", "Melangeur"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "melangeur"
            VALUE "LegalCopyright", "Copyright (c) 2026 MaTows"
            VALUE "OriginalFilename", "melangeur.exe"
            VALUE "ProductName", "Melangeur"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
